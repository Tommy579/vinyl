{
  "name": "vinyle-windows",
  "version": "1.0.0",
  "description": "Platine vinyle virtuelle pour Windows, synchronisée avec l'app Apple Music, Spotify, Deezer",
  "main": "main.js",
  "author": "Tom",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "shortcut": "node scripts/create-shortcut.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8"
  },
  "optionalDependencies": {
    "winax": "^3.6.9"
  },
  "build": {
    "appId": "com.tom.vinyle",
    "productName": "Vinyle",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "sign": null,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": "always",
      "shortcutName": "Vinyle",
      "uninstallDisplayName": "Vinyle",
      "runAfterFinish": true
    }
  }
}
